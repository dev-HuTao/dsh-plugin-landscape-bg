{
  "name": "dsh-plugin-landscape-bg",
  "version": "0.1.5",
  "type": "module",
  "description": "Landscape painting as the dsh web client background.",
  "license": "AGPL-3.0",
  "author": "horizonforge",
  "homepage": "https://github.com/horizonforge/dsh-plugin-landscape-bg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horizonforge/dsh-plugin-landscape-bg.git"
  },
  "bugs": {
    "url": "https://github.com/horizonforge/dsh-plugin-landscape-bg/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "web-client",
    "background",
    "landscape"
  ],
  "icon": "./assets/icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/icon.svg",
    "assets/screenshot.png",
    "assets/screenshot-dark.png",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
